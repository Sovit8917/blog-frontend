NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_API_PREFIX=/api/v1

# Shared secret with the backend's RevalidationService — must match
# REVALIDATE_SECRET in the backend's own .env. Generate with:
# openssl rand -base64 32
# Server-only (no NEXT_PUBLIC_ prefix): checked by src/app/api/revalidate/route.ts,
# never sent to the browser.
REVALIDATE_SECRET=change_this_revalidate_secret
